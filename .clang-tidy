Checks: '-*,bugprone-*,performance-*,-performance-no-int-to-ptr,readability-*,-readability-identifier-length,-readability-magic-numbers,-readability-braces-around-statements,-readability-convert-member-functions-to-static,-readability-implicit-bool-conversion,-modernize-use-trailing-return-type,-modernize-use-auto,-modernize-avoid-c-arrays,-bugprone-easily-swappable-parameters,-cppcoreguidelines-*'
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
CheckOptions:
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: 1
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 1
